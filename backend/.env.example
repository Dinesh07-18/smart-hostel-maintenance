# Copy this file to .env and configure your local values.
# Never commit .env or real credentials.
PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=smart_hostel_maintenance
DB_USER=
DB_PASSWORD=
JWT_SECRET=

# Comma-separated frontend origins allowed by the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Semantic search / vector services
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=2.7.0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hostel_complaint_embeddings

# Required only when running the non-destructive development demo seed.
DEMO_SEED_PASSWORD=
